---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EpisodeCard from '../components/EpisodeCard.astro';

const [latest, ...earlier] = (await getCollection('episodes')).sort((a, b) => b.data.number - a.data.number);
---

<Base>
  <h1 class="visually-hidden">Let Us Calculate</h1>

  <div class="wrap banner">
    <img src="/banner.png" alt="Old questions, new minds." width="1800" height="423" />
  </div>

  <section class="wrap episodes" aria-labelledby="episodes-heading">
    <h2 id="episodes-heading" class="label">Episodes</h2>
    {latest && <EpisodeCard ep={latest} featured />}
    {
      earlier.length > 0 && (
        <ul class="grid">
          {earlier.map((ep) => (
            <li>
              <EpisodeCard ep={ep} />
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>

<style>
  /* The banner's glow fades to the page colour (#0f0f0f), so the image has no visible edge. */
  .banner {
    padding-top: clamp(0.5rem, 3vh, 2rem);
    padding-bottom: clamp(1rem, 4vh, 2.5rem);
  }

  .banner img {
    display: block;
    width: 100%;
    max-width: 600px;
    height: auto;
    margin: 0 auto;
  }

  h2 {
    margin: 0 0 1rem;
  }

  .grid {
    list-style: none;
    margin: 3.5rem 0 0;
    padding: 2.5rem 0 0;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 2.5rem 1.5rem;
  }
</style>
