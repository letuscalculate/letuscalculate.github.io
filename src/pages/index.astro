---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Leibniz from '../components/Leibniz.astro';

const episodes = (await getCollection('episodes')).sort((a, b) => b.data.number - a.data.number);
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base>
  <Leibniz />

  <section class="wrap episodes" aria-labelledby="episodes-heading">
    <h2 id="episodes-heading" class="label">Episodes</h2>
    <ol>
      {
        episodes.map((ep) => (
          <li>
            <span class="num">{pad(ep.data.number)}</span>
            {ep.data.status === 'published' ? (
              <a class="title" href={`/episodes/${ep.id}/`}>{ep.data.title}</a>
            ) : (
              <span class="title">{ep.data.title}</span>
            )}
            <span class="meta">
              {ep.data.status === 'published' && ep.data.date
                ? ep.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })
                : 'Forthcoming'}
            </span>
            {ep.data.summary && <p class="summary">{ep.data.summary}</p>}
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .episodes {
    padding-top: 1rem;
  }

  h2 {
    margin: 0 0 0.75rem;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  li {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: baseline;
    column-gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .num,
  .meta {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .title {
    font-size: 1.35rem;
    line-height: 1.3;
    color: var(--ink);
  }

  a.title {
    text-decoration: none;
  }

  a.title:hover {
    text-decoration: underline;
    text-decoration-color: var(--red);
  }

  .summary {
    grid-column: 2 / -1;
    margin: 0.4rem 0 0;
    max-width: var(--measure);
    font-size: 0.95rem;
    color: var(--text);
  }

  @media (max-width: 480px) {
    li {
      grid-template-columns: 2rem 1fr;
    }

    .meta {
      grid-column: 2;
      margin-top: 0.3rem;
    }
  }
</style>
