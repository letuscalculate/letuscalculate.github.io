---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="wrap missing">
    <p class="decay" aria-hidden="true">C·LC·L·M·S ░ ·</p>
    <h1>This page doesn’t exist.</h1>
    <p><a href="/">Back to the episodes</a></p>
  </section>
</Base>

<style>
  .missing {
    padding-top: clamp(4rem, 18vh, 10rem);
  }

  .decay {
    margin: 0 0 1.5rem;
    font-family: var(--mono);
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--faint);
  }

  h1 {
    margin: 0 0 1rem;
    font-weight: 400;
    font-size: 1.6rem;
    color: var(--ink);
  }
</style>
